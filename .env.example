# Application
APP_NAME=Incident Management System
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/incident_db

# Redis
REDIS_URL=redis://redis:6379/0

# Gemini AI (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://frontend:3000"]

# Escalation timers (seconds)
ESCALATION_P1=300
ESCALATION_P2=900
ESCALATION_P3=1800
ESCALATION_P4=3600
